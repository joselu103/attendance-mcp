# Required: base URL for the private Attendance CRMT REST v1 service.
ATTENDANCE_MCP_CRMT_BASE_URL=http://127.0.0.1:8001

# Optional: CRMT request timeout in seconds (default: 10; allowed range: >0 to 30).
ATTENDANCE_MCP_REQUEST_TIMEOUT_SECONDS=10

# Optional: "local" and "development" use DEBUG console logs; other values use INFO JSON logs.
ATTENDANCE_MCP_RUNTIME_ENVIRONMENT=development

# Optional JSON list of additional structured log field names whose values are redacted.
# Matching is case-insensitive and treats hyphens and underscores as equivalent.
ATTENDANCE_MCP_LOG_REDACTED_KEYS=[]

# Optional JSON list of secret strings to redact wherever they occur in logged strings.
# Keep real values out of this example file; key-based redaction remains the primary safeguard.
ATTENDANCE_MCP_LOG_REDACTED_VALUES=[]
